# Copy this file to .env for local dev (netlify dev picks it up automatically).
# In production, set these in Netlify: Site settings -> Environment variables.

# Resend (https://resend.com) API key used to email the finished, signed RAMS PDF.
RESEND_API_KEY=
# "From" address for outgoing emails. Must be on a domain verified in Resend.
RESEND_FROM_EMAIL="Hutchi RAMS <rams@hutchi.tech>"

# --- Microsoft Entra ID (Azure AD) sign-in -----------------------------------
# See README.md "Entra ID setup" for step-by-step app registration instructions.
# Leave ALL FOUR of these blank to run in unauthenticated local "dev mode"
# (everyone gets full admin access, with a visible banner) -- useful for
# working on the UI without an Entra tenant to hand.

# Used by the FRONTEND build (must be prefixed VITE_ so Vite exposes them to
# the browser bundle):
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# Defaults to the site's own origin if left blank -- only set this if the
# app is served from a different URL than the one registered as the redirect
# URI in the app registration.
VITE_ENTRA_REDIRECT_URI=

# Used by the Netlify Functions backend to verify tokens (server-side, no
# VITE_ prefix -- these must match the same tenant/app as the VITE_ ones above):
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Netlify Blobs works automatically on Netlify (no keys needed) once the site
# is deployed. No action needed here for production; blobs are unavailable
# when running `vite` directly (use `netlify dev` to test storage locally).
